[Unit]
Description=MikroTik client location monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikrotik-monitor
Group=mikrotik-monitor
WorkingDirectory=/opt/mikrotik-client-monitor
EnvironmentFile=/etc/mikrotik-client-monitor.env
ExecStart=/opt/mikrotik-client-monitor/.venv/bin/mikrotik-client-monitor run
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
