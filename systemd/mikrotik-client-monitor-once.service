[Unit]
Description=Poll MikroTik client locations once
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mikrotik-monitor
Group=mikrotik-monitor
WorkingDirectory=/opt/mikrotik-client-monitor
EnvironmentFile=/etc/mikrotik-client-monitor.env
ExecStart=/opt/mikrotik-client-monitor/.venv/bin/mikrotik-client-monitor once
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
