# Copy to .env in the home-directory checkout; edit locally and chmod 600.
ROUTER_HOST=router.example.net
ROUTER_PORT=22
ROUTER_USER=metrics-reader
SSH_KEY_PATH=/home/YOUR_USER/.ssh/mikrotik_monitor_ed25519
SSH_KNOWN_HOSTS=/home/YOUR_USER/.ssh/mikrotik_monitor_known_hosts
SSH_TIMEOUT_SECONDS=15
# Used by the optional continuous `run` command; the timer interval is in its unit.
POLL_INTERVAL_SECONDS=120
ROUTER_LABEL=router-a
# Keep the outer single quotes when editing JSON for systemd EnvironmentFile.
INTERFACE_NAMES_JSON='{"ether2":"Office AP","ether3":"Workshop switch"}'
DEVICE_NAMES_JSON='{}'
GRAFANA_URL=https://metrics.example.net/api/prom/push
GRAFANA_USER=your-metrics-instance-id
GRAFANA_TOKEN=your-metrics-write-token
HTTP_TIMEOUT_SECONDS=15
