{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus-compatible data source containing MikroTik Client Monitor metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "mikrotik-client-monitor",
  "title": "MikroTik Client Monitor",
  "description": "Bridge-learned clients, router-facing interface/AP labels, and collector health from MikroTik Client Monitor. Client location is inferred from the bridge FDB.",
  "tags": [
    "mikrotik",
    "network",
    "clients"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Collector",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "1 means every selected router's most recent collector run succeeded. No data means the collector has not reported recently.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min((mikrotik_collector_up{router=~\"$router\"} and (time() - timestamp(mikrotik_collector_up{router=~\"$router\"}) < ${freshness_seconds})))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SSH failed",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Learned clients",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Clients currently learned in the bridge FDB.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum((mikrotik_clients_by_interface{router=~\"$router\"} and (time() - timestamp(mikrotik_clients_by_interface{router=~\"$router\"}) < ${freshness_seconds}))) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Bound DHCP leases",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Bound leases with valid IP and MAC; some may not be in the FDB.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum((mikrotik_bound_leases{router=~\"$router\"} and (time() - timestamp(mikrotik_bound_leases{router=~\"$router\"}) < ${freshness_seconds}))) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Unmatched leases",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Bound leases whose MAC is absent from the current FDB.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum((mikrotik_unmatched_bound_leases{router=~\"$router\"} and (time() - timestamp(mikrotik_unmatched_bound_leases{router=~\"$router\"}) < ${freshness_seconds}))) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Ambiguous MACs",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "MACs learned on more than one location; excluded from client counts.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum((mikrotik_ambiguous_macs{router=~\"$router\"} and (time() - timestamp(mikrotik_ambiguous_macs{router=~\"$router\"}) < ${freshness_seconds}))) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Oldest successful read",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Age of the oldest last successful router read among selected routers.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(time() - (mikrotik_collector_last_success_timestamp_seconds{router=~\"$router\"} and (time() - timestamp(mikrotik_collector_last_success_timestamp_seconds{router=~\"$router\"}) < ${freshness_seconds})))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Clients by interface / AP",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The AP name is a configured friendly label for the router-facing interface; it is not a Wi-Fi association reading.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(mikrotik_clients_by_interface{router=~\"$router\"} and (time() - timestamp(mikrotik_clients_by_interface{router=~\"$router\"}) < ${freshness_seconds}))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{router}} · {{ap}} ({{interface}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Current clients",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current bridge-learned MACs with DHCP and configured name enrichment. Blank IP/name means no matching bound DHCP lease. Table reflects the selected freshness window.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(mikrotik_client_info{router=~\"$router\"} and (time() - timestamp(mikrotik_client_info{router=~\"$router\"}) < ${freshness_seconds}))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "AP",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "ap": 2,
              "interface": 3,
              "mac": 4,
              "vlan": 5,
              "bridge": 6,
              "router": 7
            },
            "renameByName": {
              "hostname": "Device",
              "ip": "IP",
              "ap": "AP",
              "interface": "Interface",
              "mac": "MAC",
              "vlan": "VLAN",
              "bridge": "Bridge",
              "router": "Router"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Learned clients over time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Historical total of recently learned clients. FDB entries can age out when devices are quiet.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum((mikrotik_clients_by_interface{router=~\"$router\"} and (time() - timestamp(mikrotik_clients_by_interface{router=~\"$router\"}) < ${freshness_seconds}))) or vector(0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "title": "Clients by interface over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Historical counts by router-facing interface; old series are filtered by sample freshness at each point in time.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(mikrotik_clients_by_interface{router=~\"$router\"} and (time() - timestamp(mikrotik_clients_by_interface{router=~\"$router\"}) < ${freshness_seconds}))",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{router}} · {{ap}} ({{interface}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "2m",
      "5m",
      "10m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "router",
        "label": "Router",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(mikrotik_collector_up, router)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(mikrotik_collector_up, router)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "sort": 1
      },
      {
        "name": "freshness_seconds",
        "label": "Freshness",
        "type": "custom",
        "query": "180,300,600,900",
        "current": {
          "selected": true,
          "text": "300",
          "value": "300"
        },
        "options": [
          {
            "selected": false,
            "text": "180",
            "value": "180"
          },
          {
            "selected": true,
            "text": "300",
            "value": "300"
          },
          {
            "selected": false,
            "text": "600",
            "value": "600"
          },
          {
            "selected": false,
            "text": "900",
            "value": "900"
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "links": []
}
